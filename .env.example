# nuck-server configuration. Copy to `.env` and edit. Never commit `.env`.

# Address the HTTP API binds to.
NUCK_BIND_ADDR=127.0.0.1:8008

# This server's Matrix server_name (its federation identity, ADR 0009).
NUCK_SERVER_NAME=nuck.example.com

# Postgres for the derived index (ADR 0015). Optional in development: when unset the
# server runs without the projection store.
DATABASE_URL=postgres://nuck:nuck@localhost:5432/nuck

# Local Tuwunel (never internet-facing, ADR 0028). No admin token is stored: nuck-server
# reads room state as the projector and gates approval logins itself (ADR 0046).
TUWUNEL_URL=http://localhost:8008

# AppService registration (ADR 0019). `hs_token` is the shared secret Tuwunel presents
# on every transaction push; `as_token` is the secret this service presents to Tuwunel
# (used to act as AppService-managed users); `user` is the projector user this
# AppService claims.
APPSERVICE_HS_TOKEN=
APPSERVICE_AS_TOKEN=
APPSERVICE_USER=@nuck-projector:example.com

# The privileged action bot (ADR 0041): an AppService-managed user that performs
# privileged guild writes. `NUCK_BOT_TOKEN` is the AppService token it authenticates
# with; it defaults to APPSERVICE_AS_TOKEN when unset.
NUCK_BOT_USER=@nuck-bot:example.com
NUCK_BOT_TOKEN=

# Registration ID and the base URL Tuwunel pushes transactions to (Tuwunel appends
# `/transactions/{txnId}`). Leave APPSERVICE_URL unset for a receive-only registration.
APPSERVICE_ID=nuck-projector
APPSERVICE_URL=http://nuck-server:8008/_matrix/app/v1

# Where to write the generated registration file — point this at Tuwunel's
# `appservice_dir`. Tuwunel loads it on restart; apply the same YAML live with
# `!admin appservices register`. Unset to manage registration out of band.
APPSERVICE_REGISTRATION_PATH=

# Reconciliation loop (ADR 0019): how often to re-read room state, whether to run a
# pass on startup, and how many recent messages per channel to backfill into search on
# that startup pass (`none` disables the backfill).
NUCK_RECONCILE_INTERVAL_SECS=300
NUCK_RECONCILE_ON_STARTUP=true
NUCK_MESSAGE_BACKFILL_LIMIT=200

# Registration policy (ADR 0037/0046): open | token | approval | closed.
# `approval` needs no admin token — nuck-server holds the account and blocks its login
# until an admin approves. `NUCK_ADMIN_USERS` lists the operator admins who may approve.
NUCK_REGISTRATION_MODE=token
NUCK_REGISTRATION_TOKEN=
NUCK_ADMIN_USERS=

# Logging.
RUST_LOG=nuck_server=info,tower_http=info
